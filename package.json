{
  "name": "parabank-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript autotests for ParaBank",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:api": "playwright test --project=api",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "report": "playwright show-report",
    "allure:generate": "allure generate",
    "allure:open": "allure open allure-report",
    "stand:up": "docker compose -f docker/docker-compose.yml up -d --wait parabank",
    "stand:down": "docker compose -f docker/docker-compose.yml down",
    "test:docker": "docker compose -f docker/docker-compose.yml run --rm --build tests"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "dotenv": "^18.0.8",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "fast-xml-parser": "^5.11.2",
    "playwright-bdd": "^9.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2"
  }
}
